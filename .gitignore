# Configurazione con valori reali: mai nel repo (il repo è pubblico)
.env

# Temi commerciali (Impreza): non ridistribuibili
/docker/themes/*
!/docker/themes/.gitkeep

# Plugin commerciali (WPML): non ridistribuibili
/docker/plugins/*
!/docker/plugins/.gitkeep
!/docker/plugins/commerciali.txt

# Backup della configurazione fatti da bin/wordpress-config.sh apply --conferma
/backup/
