# Configurazione di WordPress. Copiare in .env (escluso da git) e compilare.
# Questo file lo legge solo Docker Compose: Laravel non lo vede.
# Le chiavi di sicurezza di WordPress NON vanno qui: le genera WP-CLI in wp-config.php.

# Porta su cui WordPress risponde, solo su 127.0.0.1
WP_PORT=8090
# Indirizzo pubblico del sito. In locale http://localhost:8090, su UAT https://wp.forestas.uat.maphub.it
WP_URL=http://localhost:8090
# Titolo usato solo all'installazione: poi vale blogname di config/sito.json
WP_TITLE=Sardegna Sentieri

WP_DB_NAME=wordpress
WP_DB_USER=wordpress
WP_DB_PASSWORD=cambiami

WP_ADMIN_USER=cambiami
WP_ADMIN_PASSWORD=cambiami
WP_ADMIN_EMAIL=cambiami@example.org

# Ambiente: vuoto, oppure «produzione». In produzione i file di WordPress (core, temi, plugin) non si
# modificano dal pannello: DISALLOW_FILE_MODS.
WP_AMBIENTE=

# Licenze e chiavi: valori reali solo nel .env. Non si applicano se WP_URL è localhost o 127.0.0.1.
# Site key del sito su wpml.org (Account WPML → Siti)
WPML_SITE_KEY=
# Segreto di attivazione di Impreza (opzione us_license_secret del sito attivato)
IMPREZA_LICENSE_SECRET=
# Chiave del link privato che scavalca la modalità manutenzione di Impreza
IMPREZA_MAINTENANCE_KEY=

# Sincronizzazione delle pagine statiche dalla copia del database Drupal (bin/wordpress-config.sh
# pagine, oc:8758). on: il comando scrive; off o vuoto: solo anteprima. Va messo a off al passaggio in
# produzione, quando WordPress diventa la fonte dei contenuti.
DRUPAL_SYNC=off
# Copia del database Drupal, in sola lettura. Host, porta e database vuoti valgono i default di UAT e
# produzione: il container mysql-sardegnasentieri-dump sulla rete Docker dello shard, porta 3306,
# database sardegnasentieri. Utente e password sono obbligatori (l'utente in sola lettura della copia,
# forestas/docs/howto/copia-database-drupal.md): senza, la sincronizzazione si ferma. In locale, col
# tunnel SSH verso la copia di UAT aperto sulla 3307 del Mac: DRUPAL_DB_HOST=host.docker.internal e
# DRUPAL_DB_PORT=3307. Dopo una modifica: scripts/wordpress-up.sh di forestas (il container legge il
# .env quando viene creato).
DRUPAL_DB_HOST=
DRUPAL_DB_PORT=
DRUPAL_DB_NAME=
DRUPAL_DB_USER=
DRUPAL_DB_PASSWORD=
# Indirizzo da cui si scaricano i file di Drupal (immagini, gallerie, allegati di pagine e news, oc:8759):
# la copia del database ha solo le righe dei file, non i file. Vuoto vale il sito pubblico
# (https://www.sardegnasentieri.it/sites/default/files/). Prima dello spegnimento di Drupal va copiata la
# cartella sites/default/files sul server e questo indirizzo va puntato lì. Dopo una modifica:
# scripts/wordpress-up.sh di forestas.
DRUPAL_FILES_URL=
